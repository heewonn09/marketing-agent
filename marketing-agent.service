[Unit]
Description=Marketing Agent - 마케팅 자동화 에이전트
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__

# gunicorn: 1 worker + gthread로 SSE 장기 연결 지원, timeout 0으로 SSE 끊김 방지
ExecStart=__APP_DIR__/venv/bin/gunicorn \
    --workers 1 \
    --worker-class gthread \
    --threads 4 \
    --timeout 0 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=always
RestartSec=10

# e2-micro 메모리 보호: Playwright(Chromium) 실행 중 OOM 방지
MemoryMax=900M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=marketing-agent

[Install]
WantedBy=multi-user.target
